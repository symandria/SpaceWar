#----------------------------- Global Properties ----------------------------#

/outputDir:bin/
/intermediateDir:obj/
/platform:Windows
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

#---------------------------------- Content ---------------------------------#

#begin backgrounds/SpaceWarsLogo.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:GenerateMipmaps=False
/processorParam:MakeSquare=False
/processorParam:ResizeToPowerOfTwo=False
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/processorParam:ColorKeyEnabled=True
/processorParam:ColorKeyColor=255,0,255,255
/build:backgrounds/SpaceWarsLogo.png

#begin backgrounds/splash.png
/importer:TextureImporter
/processor:TextureProcessor
/processorParam:GenerateMipmaps=False
/processorParam:MakeSquare=False
/processorParam:ResizeToPowerOfTwo=False
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Color
/processorParam:ColorKeyEnabled=True
/processorParam:ColorKeyColor=255,0,255,255
/build:backgrounds/splash.png

#begin bin/Content/bin/Windows/Content/raw_fonts/Orbitron-Bold.ttf
/copy:bin/Content/bin/Windows/Content/raw_fonts/Orbitron-Bold.ttf

#begin bin/Content/bin/Windows/Content/raw_fonts/Roboto-Regular.ttf
/copy:bin/Content/bin/Windows/Content/raw_fonts/Roboto-Regular.ttf

#begin bin/Content/raw_fonts/Orbitron-Bold.ttf
/copy:bin/Content/raw_fonts/Orbitron-Bold.ttf

#begin bin/Content/raw_fonts/Roboto-Regular.ttf
/copy:bin/Content/raw_fonts/Roboto-Regular.ttf

#begin bin/Windows/Content/raw_fonts/Orbitron-Bold.ttf
/copy:bin/Windows/Content/raw_fonts/Orbitron-Bold.ttf

#begin bin/Windows/Content/raw_fonts/Roboto-Regular.ttf
/copy:bin/Windows/Content/raw_fonts/Roboto-Regular.ttf

#begin fonts/menu.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:TextureFormat=Compressed
/processorParam:PremultiplyAlpha=True
/build:fonts/menu.spritefont

#begin fonts/title.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:TextureFormat=Compressed
/processorParam:PremultiplyAlpha=True
/build:fonts/title.spritefont

#begin raw_fonts/Orbitron-Bold.ttf
/copy:raw_fonts/Orbitron-Bold.ttf

#begin raw_fonts/Roboto-Regular.ttf
/copy:raw_fonts/Roboto-Regular.ttf

